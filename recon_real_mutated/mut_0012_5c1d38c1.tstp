thf(fact_602_nat__eq__add__iff2, axiom,
    ((![I : nat, J : nat, U : nat, M : nat, N : nat]: ((ord_less_eq_nat @ I @ J) => (((plus_plus_nat @ (times_times_nat @ I @ U) @ M) = (plus_plus_nat @ (times_times_nat @ J @ U) @ N)) = (M = (plus_plus_nat @ (times_times_nat @ (minus_minus_nat @ J @ I) @ U) @ N)))))), [], [isabelle_rank(3595)]). % nat_eq_add_iff2

% Conjectures (1)
